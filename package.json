{
  "name": "cine-match-ai",
  "version": "3.2.0",
  "description": "Recomendador personal de películas y series (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
